{
  "name": "jev-proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker holding the TypeSafe Jev key so the Aware app never does",
  "scripts": {
    "test": "tsc --noEmit && vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir /tmp/jev-proxy-dryrun",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
